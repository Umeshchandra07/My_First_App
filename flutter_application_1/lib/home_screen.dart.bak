                    ),
                  ],
                ),
              ),

              // --- TOP HORIZONTAL STORY BUBBLES ---
              SizedBox(
                height: 110,
                child: ListView(
                  scrollDirection: Axis.horizontal,
                  padding: const EdgeInsets.symmetric(
                    horizontal: 16,
                    vertical: 10,
                  ),
                  children: [
                    _buildStoryBubble(
                      name: 'Ibiza',
                      image: 'assets/Chat_1.jpeg',
                      hasUnread: true,
                      fg: fg,
                    ),
                    _buildStoryBubble(
                      name: 'Blake',
                      image: 'assets/Chat_2.jpeg',
                      fg: fg,
                    ),
                    _buildStoryBubble(
                      name: 'Greece',
                      image: 'assets/Chat_3.jpeg',
                      fg: fg,
                    ),
                    _buildStoryBubble(
                      name: 'Greece',
                      image: 'assets/Chat_4.jpeg',
                      fg: fg,
                    ),
                    _buildStoryBubble(
                      name: 'Greece',
                      image: 'assets/Chat_5.jpeg',
                      fg: fg,
                    ),
                    _buildStoryBubble(
                      name: 'Greece',
                      image: 'assets/Chat_6.jpeg',
                      fg: fg,
                    ),
                    _buildStoryBubble(
                      name: 'Greece',
                      image: 'assets/Chat_5.jpeg',
                      fg: fg,
                    ),
                    _buildStoryBubble(
                      name: 'Greece',
                      image: 'assets/Chat_4.jpeg',
                      fg: fg,
                    ),
                    _buildStoryBubble(
                      name: 'Greece',
                      image: 'assets/Chat_3.jpeg',
                      fg: fg,
                    ),
                    _buildStoryBubble(
                      name: 'Greece',
                      image: 'assets/Chat_2.jpeg',
                      fg: fg,
                    ),
                    _buildStoryBubble(
                      name: 'Greece',
                      image: 'assets/Chat_1.jpeg',
                      fg: fg,
                    ),
