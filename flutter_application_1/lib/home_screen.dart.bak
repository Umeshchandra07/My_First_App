  Widget _buildStoryBubble({
    required String name,
    required String image,
    bool hasUnread = false,
    required Color fg,
  }) {
    return Container(
      width: 72,
      margin: const EdgeInsets.only(right: 12),
      child: Column(
        children: [
          Stack(
            children: [
              Container(
                padding: const EdgeInsets.all(2),
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  border: hasUnread
                      ? Border.all(color: Colors.blue, width: 2.5)
                      : Border.all(color: Colors.grey.shade300, width: 1.5),
                ),
                child: CircleAvatar(
                  radius: 26,
                  backgroundImage: AssetImage(image),
                  backgroundColor: Colors.grey.shade200,
                ),
              ),
              if (hasUnread)
                Positioned(
                  right: 0,
                  bottom: 0,
                  child: Container(
                    width: 14,
                    height: 14,
                    decoration: BoxDecoration(
                      color: Colors.blue,
                      shape: BoxShape.circle,
                      border: Border.all(color: Colors.white, width: 2),
                    ),
                  ),
                ),
            ],
          ),
          const SizedBox(height: 6),
          Text(
            name,
            maxLines: 1,
            overflow: TextOverflow.ellipsis,
            style: TextStyle(color: fg, fontSize: 11, fontWeight: FontWeight.w500),
            textAlign: TextAlign.center,
          ),
        ],
      ),
    );
  }

  Widget _buildChatTile({
    required String name,
    required String message,
    required String avatar,
    bool hasUnreadDot = false,
    bool isSystemBadge = false,
    required Color fg,
    required Color sub,
  }) {
    return ListTile(
      contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),
      leading: Stack(
        children: [
          CircleAvatar(
            radius: 26,
            backgroundImage: AssetImage(avatar),
            backgroundColor: Colors.grey.shade200,
          ),
          if (isSystemBadge)
            Positioned(
              right: 0,
              bottom: 0,
              child: Container(
                padding: const EdgeInsets.all(2),
                decoration: BoxDecoration(
                  color: Colors.blue,
                  shape: BoxShape.circle,
                  border: Border.all(color: Colors.white, width: 2),
                ),
                child: const Icon(Icons.verified, size: 10, color: Colors.white),
              ),
            ),
          if (hasUnreadDot)
            Positioned(
              right: 0,
              bottom: 8,
              child: Container(
                width: 10,
                height: 10,
                decoration: BoxDecoration(
                  color: Colors.green,
                  shape: BoxShape.circle,
                  border: Border.all(color: Colors.white, width: 2),
                ),
              ),
            ),
        ],
      ),
      title: Row(
        children: [
          Expanded(
            child: Text(
              name,
              style: TextStyle(
                color: fg,
                fontWeight: FontWeight.w600,
                fontSize: 15,
              ),
              maxLines: 1,
              overflow: TextOverflow.ellipsis,
            ),
          ),
          Text(
            '12:30',
            style: TextStyle(color: sub, fontSize: 11),
          ),
        ],
      ),
      subtitle: Row(
        children: [
          if (isSystemBadge)
            Container(
              margin: const EdgeInsets.only(right: 4, top: 2),
              padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 1),
              decoration: BoxDecoration(
                color: Colors.blue.shade100,
                borderRadius: BorderRadius.circular(4),
              ),
              child: Text(
                'System',
                style: TextStyle(
                  color: Colors.blue.shade700,
                  fontSize: 9,
                  fontWeight: FontWeight.w600,
                ),
              ),
            ),
          Expanded(
            child: Text(
              message,
              style: TextStyle(color: sub, fontSize: 13),
              maxLines: 1,
              overflow: TextOverflow.ellipsis,
            ),
          ),
        ],
      ),
      onTap: () {},
    );
  }
}

