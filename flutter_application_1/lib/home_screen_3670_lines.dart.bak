class NotificationsPage extends StatelessWidget {
  const NotificationsPage({super.key});

  static const _notifications = [
    {
      'icon': Icons.favorite,
      'color': Colors.red,
      'title': 'Bunny liked your story',
      'subtitle': 'Diwali looks after night',
      'time': '5m ago',
      'read': false,
    },
    {
      'icon': Icons.location_on,
      'color': Colors.orange,
      'title': 'New celebration spot discovered',
      'subtitle': 'Celebration hub • 8 min away in Hyderabad',
      'time': '45m ago',
      'read': false,
    },
    {
      'icon': Icons.person_add,
      'color': Colors.blue,
      'title': 'Priya Sharma started following you',
      'subtitle': 'Connect with other local creators',
      'time': '2h ago',
      'read': true,
    },
    {
      'icon': Icons.mode_comment,
      'color': Colors.teal,
      'title': 'Alex Chen replied to your story',
      'subtitle': '"The lights look fantastic! ✨"',
      'time': '5h ago',
      'read': true,
    },
    {
      'icon': Icons.star,
      'color': Colors.amber,
      'title': 'Trending in Hyderabad',
      'subtitle': 'Festival of Lights has 1.2k nearby viewers',
      'time': '1d ago',
      'read': true,
    },
  ];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.white,
      appBar: AppBar(
        backgroundColor: Colors.white,
        elevation: 0,
        title: Text(
          AppStrings.get('notifications', globalLanguageNotifier.value),
          style: const TextStyle(
            color: Colors.black,
            fontWeight: FontWeight.bold,
            fontSize: 22,
          ),
        ),
        actions: [
          TextButton(
            onPressed: () {},
            child: const Text(
              'Mark all read',
              style: TextStyle(color: Color(0xFF8A2BE2)),
            ),
          ),
        ],
      ),
      body: ListView(
        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
        children: [
          // Filter Chips
          Row(
            children: [
              _buildFilterChip('All', isSelected: true),
              const SizedBox(width: 8),
              _buildFilterChip('Unread', isSelected: false),
              const SizedBox(width: 8),
              _buildFilterChip('Nearby', isSelected: false),
            ],
          ),
          const SizedBox(height: 16),

          ..._notifications.map((n) {
            final isRead = n['read'] as bool;
            return Container(
              margin: const EdgeInsets.only(bottom: 12),
              padding: const EdgeInsets.all(12),
              decoration: BoxDecoration(
                color: isRead ? Colors.grey[50] : const Color(0xFFFBF6FF),
                borderRadius: BorderRadius.circular(12),
                border: Border.all(
                  color: isRead ? Colors.grey[200]! : const Color(0xFFE5D5F9),
                ),
              ),
              child: Row(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  CircleAvatar(
                    radius: 20,
                    backgroundColor: (n['color'] as Color).withValues(
                      alpha: 0.15,
                    ),
                    child: Icon(
                      n['icon'] as IconData,
                      color: n['color'] as Color,
                      size: 20,
                    ),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text(
                          n['title'] as String,
                          style: TextStyle(
                            fontWeight: isRead
                                ? FontWeight.w600
                                : FontWeight.bold,
                            fontSize: 14,
                          ),
                        ),
                        const SizedBox(height: 4),
                        Text(
                          n['subtitle'] as String,
                          style: TextStyle(
                            color: Colors.grey[700],
                            fontSize: 13,
                          ),
                        ),
                        const SizedBox(height: 6),
                        Text(
                          n['time'] as String,
                          style: TextStyle(
                            color: Colors.grey[500],
                            fontSize: 11,
                          ),
                        ),
                      ],
                    ),
                  ),
                  if (!isRead)
                    Container(
                      width: 8,
                      height: 8,
                      margin: const EdgeInsets.only(top: 6),
                      decoration: const BoxDecoration(
                        color: Color(0xFF8A2BE2),
                        shape: BoxShape.circle,
                      ),
                    ),
                ],
              ),
            );
          }),
        ],
      ),
    );
  }

  Widget _buildFilterChip(String label, {required bool isSelected}) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 6),
      decoration: BoxDecoration(
        color: isSelected ? const Color(0xFF8A2BE2) : Colors.grey[100],
        borderRadius: BorderRadius.circular(20),
      ),
      child: Text(
        label,
        style: TextStyle(
          color: isSelected ? Colors.white : Colors.black87,
          fontSize: 13,
          fontWeight: isSelected ? FontWeight.bold : FontWeight.normal,
        ),
      ),
    );
  }
}

class ProfilePage extends StatefulWidget {
  final UserProfile user;
  const ProfilePage({super.key, required this.user});

  @override
  State<ProfilePage> createState() => _ProfilePageState();
}

class _ProfilePageState extends State<ProfilePage> {
  int _selectedTab = 0;

  @override
  Widget build(BuildContext context) {
    return ValueListenableBuilder<String>(
      valueListenable: globalLanguageNotifier,
      builder: (context, currentLang, _) {
        ImageProvider getProfileImage() {
          if (widget.user.profileImagePath.startsWith('assets/')) {
            return AssetImage(widget.user.profileImagePath);
          }
          return FileImage(File(widget.user.profileImagePath));
        }

        final List<Map<String, String>> posts = [
          {'image': 'assets/profile_1.jpeg', 'time': '0:45', 'views': '24.8K'},
          {'image': 'assets/profile_2.jpeg', 'time': '0:32', 'views': '18.2K'},
          {'image': 'assets/profile_3.jpeg', 'time': '0:27', 'views': '12.6K'},
          {'image': 'assets/profile_4.jpeg', 'time': '0:39', 'views': '22.1K'},
          {'image': 'assets/profile_5.jpeg', 'time': '0:21', 'views': '9.8K'},
          {'image': 'assets/profile_6.jpeg', 'time': '0:36', 'views': '16.4K'},
        ];

        return Scaffold(
          backgroundColor: Colors.white,
          body: SafeArea(
            child: Column(
              children: [
                // --- TOP APPBAR ---
                Padding(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 16,
                    vertical: 8,
                  ),
                  child: Row(
                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                    children: [
                      IconButton(
                        icon: const Icon(
                          Icons.arrow_back,
                          color: Colors.black,
                          size: 22,
                        ),
                        onPressed: () {
                          globalTabIndexNotifier.value = 0;
                          Navigator.pushReplacement(
                            context,
                            PageRouteBuilder(
                              pageBuilder: (
                                context,
                                animation,
                                secondaryAnimation,
                              ) => MainScreen(user: widget.user),
                              transitionsBuilder:
                                  (
                                    context,
                                    animation,
                                    secondaryAnimation,
                                    child,
                                  ) {
                                    const begin = Offset(-1.0, 0.0);
                                    const end = Offset.zero;
                                    final tween = Tween(begin: begin, end: end)
                                        .chain(
                                          CurveTween(
                                            curve: Curves.easeInOutCubic,
                                          ),
                                        );
                                    return SlideTransition(
                                      position: animation.drive(tween),
                                      child: child,
                                    );
                                  },
                              transitionDuration: const Duration(
                                milliseconds: 300,
                              ),
                            ),
                          );
                        },
                      ),
                      Row(
                        children: [
                          IconButton(
                            icon: const Icon(
                              Icons.notifications_none,
                              color: Colors.black87,
                              size: 22,
                            ),
                            onPressed: () {
                              // Add your notification action here
                            },
                          ),
                          IconButton(
                            icon: const Icon(
                              Icons.settings_outlined,
                              color: Colors.black87,
                              size: 22,
                            ),
                            onPressed: () {
                              navigateWithSlide(
                                context,
                                SettingsPage(user: widget.user),
                              );
                            },
                          ),
                        ],
                      ),
                    ],
                  ),
                ),

                // --- HEADER INFO: Avatar Left, Name & Bio Right ---
                Padding(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 16.0,
                    vertical: 4.0,
                  ),
                  child: Row(
                    crossAxisAlignment: CrossAxisAlignment.center,
                    children: [
                      GestureDetector(
                        onTap: () => _openFullScreenViewer(
                          context,
                          widget.user.profileImagePath,
                          widget.user.userName.isNotEmpty
                              ? widget.user.userName
                              : 'user',
                          'Profile Picture',
                        ),
                        child: CircleAvatar(
                          radius: 40,
                          backgroundColor: Colors.grey[200],
                          backgroundImage: getProfileImage(),
                        ),
                      ),
                      const SizedBox(width: 20),
                      Expanded(
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Row(
                              children: [
                                Text(
                                  widget.user.userName.isNotEmpty
                                      ? widget.user.userName
                                      : 'user',
                                  style: const TextStyle(
                                    color: Colors.black,
                                    fontWeight: FontWeight.bold,
                                    fontSize: 16,
                                  ),
                                ),
                                const SizedBox(width: 4),
                                const Icon(
                                  Icons.verified,
                                  color: Colors.blue,
                                  size: 15,
                                ),
                              ],
                            ),
                            const SizedBox(height: 2),
                            Text(
                              '@${widget.user.userName.isNotEmpty ? widget.user.userName.toLowerCase().replaceAll(' ', '') : 'user'}',
                              style: const TextStyle(
                                color: Colors.black54,
                                fontSize: 13,
                              ),
                            ),
                            const SizedBox(height: 4),
                            Text(
                              widget.user.bio.isNotEmpty
                                  ? widget.user.bio
                                  : 'User',
                              style: const TextStyle(
                                color: Colors.black87,
                                fontSize: 13,
                              ),
                            ),
                          ],
                        ),
                      ),
                    ],
                  ),
                ),

                const SizedBox(height: 16),

                // --- POSTS, FOLLOWERS & FOLLOWING STATS ROW ---
                Padding(
                  padding: const EdgeInsets.symmetric(vertical: 12.0),
                  child: Row(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      GestureDetector(
                        onTap: () {},
                        child: Column(
                          children: [
                            const Text(
                              '48',
                              style: TextStyle(
                                fontSize: 16,
                                fontWeight: FontWeight.bold,
                                color: Colors.black87,
                              ),
                            ),
                            Text(
                              AppStrings.get('posts'),
                              style: const TextStyle(
                                fontSize: 13,
                                color: Colors.grey,
                              ),
                            ),
                          ],
                        ),
                      ),
                      const SizedBox(width: 24),
                      Container(height: 24, width: 1, color: Colors.grey[300]),
                      const SizedBox(width: 24),
                      GestureDetector(
                        onTap: () {
                          navigateWithSlide(
                            context,
                            const FollowersFollowingPage(title: 'Followers'),
                          );
                        },
                        child: Column(
                          children: [
                            const Text(
                              '1,420',
                              style: TextStyle(
                                fontSize: 16,
                                fontWeight: FontWeight.bold,
                                color: Colors.black87,
                              ),
                            ),
                            Text(
                              AppStrings.get('followers'),
                              style: const TextStyle(
                                fontSize: 13,
                                color: Colors.grey,
                              ),
                            ),
                          ],
                        ),
                      ),
                      const SizedBox(width: 24),
                      Container(height: 24, width: 1, color: Colors.grey[300]),
                      const SizedBox(width: 24),
                      GestureDetector(
                        onTap: () {
                          navigateWithSlide(
                            context,
                            const FollowersFollowingPage(title: 'Following'),
                          );
                        },
                        child: Column(
                          children: [
                            const Text(
                              '384',
                              style: TextStyle(
                                fontSize: 16,
                                fontWeight: FontWeight.bold,
                                color: Colors.black87,
                              ),
                            ),
                            Text(
                              AppStrings.get('following'),
                              style: const TextStyle(
                                fontSize: 13,
                                color: Colors.grey,
                              ),
                            ),
                          ],
                        ),
                      ),
                    ],
                  ),
                ),

                const SizedBox(height: 16),

                // --- EDIT PROFILE BUTTON & ADD FRIEND ---
                Padding(
                  padding: const EdgeInsets.symmetric(horizontal: 16.0),
                  child: Row(
                    children: [
                      Expanded(
                        child: GestureDetector(
                          onTap: () {
                            // Action when Edit Profile is tapped
                          },
                          child: Container(
                            height: 38,
                            decoration: BoxDecoration(
                              color: Colors.white,
                              borderRadius: BorderRadius.circular(8),
                              border: Border.all(color: Colors.grey[300]!),
                            ),
                            alignment: Alignment.center,
                            child: Text(
                              AppStrings.get('edit_profile', currentLang),
                              style: const TextStyle(
                                color: Colors.black,
                                fontWeight: FontWeight.bold,
                                fontSize: 13,
                              ),
                            ),
                          ),
                        ),
                      ),
                      const SizedBox(width: 8),
                      GestureDetector(
                        onTap: () {
                          // Action when Add Friend is tapped
                        },
                        child: Container(
                          width: 38,
                          height: 38,
                          decoration: BoxDecoration(
                            color: Colors.white,
                            borderRadius: BorderRadius.circular(8),
                            border: Border.all(color: Colors.grey[300]!),
                          ),
                          alignment: Alignment.center,
                          child: const Icon(
                            Icons.person_add_outlined,
                            color: Colors.black87,
                            size: 18,
                          ),
                        ),
                      ),
                    ],
                  ),
                ),

                const SizedBox(height: 16),

                // --- TABS ---
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceAround,
                  children: [
                    _buildTabItem(
                      Icons.play_circle_outline,
                      'Videos',
                      _selectedTab == 0,
                      () => setState(() => _selectedTab = 0),
                    ),
                    _buildTabItem(
                      Icons.favorite_border,
                      'Liked',
                      _selectedTab == 1,
                      () => setState(() => _selectedTab = 1),
                    ),
                    _buildTabItem(
                      Icons.bookmark_border,
                      'Saved',
                      _selectedTab == 2,
                      () => setState(() => _selectedTab = 2),
                    ),
                  ],
                ),
                Divider(color: Colors.grey[200], thickness: 1, height: 1),

                // --- POSTS GRID WITH EXACT ASPECT RATIO ---
                Expanded(
                  child: GridView.builder(
                    padding: const EdgeInsets.all(1),
                    itemCount: posts.length,
                    gridDelegate:
                        const SliverGridDelegateWithFixedCrossAxisCount(
                          crossAxisCount: 3,
                          crossAxisSpacing: 1.5,
                          mainAxisSpacing: 1.5,
                          childAspectRatio:
                              0.72, // Matches the reference height ratio
                        ),
                    itemBuilder: (context, index) {
                      final post = posts[index];
                      return GestureDetector(
                        onTap: () => _openFullScreenViewer(
                          context,
                          post['image']!,
                          'Post #${index + 1}',
                          '${post['time']} • ${post['views']}',
                        ),
                        child: ClipRRect(
                          borderRadius: BorderRadius.circular(8),
                          child: Stack(
                            fit: StackFit.expand,
                            children: [
                              Image.asset(
                                post['image']!,
                                fit: BoxFit.cover,
                                errorBuilder: (context, error, stackTrace) =>
                                    Container(color: Colors.grey[200]),
                              ),
                              Positioned(
                                bottom: 6,
                                left: 6,
                                child: Row(
                                  children: [
                                    const Icon(
                                      Icons.play_arrow,
                                      color: Colors.white,
                                      size: 13,
                                    ),
                                    const SizedBox(width: 2),
                                    Text(
                                      '${post['time']}    ${post['views']}',
                                      style: const TextStyle(
                                        color: Colors.white,
                                        fontSize: 10,
                                        fontWeight: FontWeight.bold,
                                        shadows: [
                                          Shadow(
                                            color: Colors.black,
                                            blurRadius: 2,
                                          ),
                                        ],
                                      ),
                                    ),
                                  ],
                                ),
                              ),
                            ],
                          ),
                        ),
                      );
                    },
                  ),
                ),
              ],
            ),
          ),
        );
      },
    );
  }

  Widget _buildTabItem(
    IconData icon,
    String label,
    bool isActive,
    VoidCallback onTap,
  ) {
    return Expanded(
      child: GestureDetector(
        onTap: onTap,
        child: Column(
          children: [
            Padding(
              padding: const EdgeInsets.symmetric(vertical: 10),
              child: Row(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Icon(
                    icon,
                    color: isActive ? Colors.black : Colors.black45,
                    size: 18,
                  ),
                  const SizedBox(width: 4),
                  Text(
                    label,
                    style: TextStyle(
                      color: isActive ? Colors.black : Colors.black45,
                      fontWeight: isActive
                          ? FontWeight.bold
                          : FontWeight.normal,
                      fontSize: 13,
                    ),
                  ),
                ],
              ),
            ),
            Container(
              height: 2,
              color: isActive ? Colors.black : Colors.transparent,
            ),
          ],
        ),
      ),
    );
  }

  void _openFullScreenViewer(
    BuildContext context,
    String imagePath,
    String title,
    String stats,
  ) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (context) => Scaffold(
          backgroundColor: Colors.black,
          appBar: AppBar(
            backgroundColor: Colors.transparent,
            iconTheme: const IconThemeData(color: Colors.white),
            elevation: 0,
          ),
          body: Center(
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Expanded(
                  child: imagePath.startsWith('assets/')
                      ? Image.asset(
                          imagePath,
                          fit: BoxFit.contain,
                          errorBuilder: (context, error, stackTrace) =>
                              const Center(
                                child: Icon(
                                  Icons.broken_image,
                                  color: Colors.white54,
                                  size: 48,
                                ),
                              ),
                        )
                      : Image.file(
                          File(imagePath),
                          fit: BoxFit.contain,
                          errorBuilder: (context, error, stackTrace) =>
                              const Center(
                                child: Icon(
                                  Icons.broken_image,
                                  color: Colors.white54,
                                  size: 48,
                                ),
                              ),
                        ),
                ),
                Padding(
                  padding: const EdgeInsets.all(20.0),
                  child: Text(
                    '$title • $stats',
                    style: const TextStyle(
                      color: Colors.white,
                      fontSize: 16,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

class SettingsPage extends StatelessWidget {
  final UserProfile user;

  const SettingsPage({super.key, required this.user});

  @override
  Widget build(BuildContext context) {
    final UserProfile activeUser = globalUserNotifier.value ?? user;
    return ValueListenableBuilder<String>(
      valueListenable: globalLanguageNotifier,
      builder: (context, currentLanguage, child) =>
          _buildScaffold(context, currentLanguage, activeUser),
    );
  }

  Widget _buildScaffold(
    BuildContext context,
    String currentLanguage,
    UserProfile user,
  ) {
    final handle = '@${user.userName.toLowerCase().replaceAll(' ', '_')}';
    ImageProvider profileImage;
    if (user.profileImagePath.startsWith('assets/')) {
      profileImage = AssetImage(user.profileImagePath);
    } else {
      profileImage = FileImage(File(user.profileImagePath));
    }

    return Scaffold(
      backgroundColor: const Color(0xFFF0F2F5),
      appBar: AppBar(
        backgroundColor: Colors.white,
        elevation: 0,
        leading: IconButton(
